
CLI_RANKING_STORAGE=s3-gcs

RANKING_LOG_OUTPUT=console
RANKING_LOG_FORMAT=json

# HTTP RETRY CONFIGURATION
# Status codes triggering an automatic retry with exponential backoff
# RANKING_HTTP_RETRY_STATUS_CODES=502,503,504
# Backoff delays in seconds, in retry order (max attempts = number of delays + 1)
# RANKING_HTTP_RETRY_DELAYS_SECONDS=30,60,120,300,3600

# S3 CONFIGURATIOn
RANKING_S3_BUCKET=ranking
# RANKING_S3_REGION
# RANKING_S3_ENDPOINT=

# S3 CONFIGURATION SECRETS
# DO NOT COMMIT REAL CREDENTIALS
# RANKING_S3_ACCESS_KEY_ID=
# RANKING_S3_SECRET_ACCESS_KEY
